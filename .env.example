BOOKFORGE_BOOKS_DIR=books
BOOKFORGE_PROMPTS_DIR=prompts
BOOKFORGE_STYLE_GUIDE_PATH=docs/BOOK_STYLE_GUIDE.md
BOOKFORGE_GENERATED_DIR=generated
BOOKFORGE_PROVIDER=mock
BOOKFORGE_LOG_LEVEL=info
BOOKFORGE_DEBUG=false
# Publication defaults. Copy this file to .env and customize as needed.
BOOKFORGE_PUBLICATION_AUTHOR=DecisionForge, LLC
BOOKFORGE_PUBLICATION_ORGANIZATION=DecisionForge, LLC
BOOKFORGE_PUBLICATION_VERSION=1.0
# Optional fixed publication date. If omitted, BookForge uses the export date.
# BOOKFORGE_PUBLICATION_DATE=YYYY-MM-DD
BOOKFORGE_PUBLICATION_COPYRIGHT_NOTICE=Educational material only; verify live technical, legal, and operational decisions against authoritative sources.
BOOKFORGE_PUBLICATION_LICENSE=All rights reserved unless separately stated.
# Separate multiple trademarks with semicolons.
BOOKFORGE_PUBLICATION_TRADEMARKS=DecisionForge
OPENAI_API_KEY=
BOOKFORGE_MODEL=
BOOKFORGE_TEMPERATURE=0.2
BOOKFORGE_MAX_RETRIES=3
BOOKFORGE_REQUEST_TIMEOUT_MS=120000
BOOKFORGE_JAVA_RELEASE=21
# Optional executable used for Python syntax validation.
# BOOKFORGE_PYTHON=python3
